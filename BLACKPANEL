<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>BLACKPANEL CRM</title>
<style>
:root{--bg:#0b0b0d;--panel:#151518;--panel2:#1d1d21;--line:#2c2c32;--yellow:#facc15;--text:#f5f5f5;--muted:#a1a1aa;--green:#22c55e;--red:#ef4444}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.45 Inter,Segoe UI,Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;border-radius:9px;padding:10px 13px;background:var(--yellow);color:#111;font-weight:700}button.secondary{background:#29292f;color:#eee;border:1px solid var(--line)}button.danger{background:#451a1a;color:#fecaca}.app{display:flex;min-height:100vh}.side{width:235px;background:#101012;border-right:1px solid var(--line);padding:22px 14px;flex-shrink:0}.brand{font-weight:900;letter-spacing:.5px;font-size:18px;margin:0 8px 26px}.brand span{color:var(--yellow)}.nav{display:grid;gap:5px}.nav button{background:transparent;color:#bdbdc5;text-align:left;font-weight:600}.nav button.active,.nav button:hover{background:#292710;color:var(--yellow)}.main{padding:28px;width:calc(100% - 235px);max-width:1600px;margin:auto}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:25px}.eyebrow{color:var(--yellow);font-weight:800;text-transform:uppercase;letter-spacing:1.8px;font-size:11px}.title{font-size:28px;font-weight:850;margin:4px 0}.muted{color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin:18px 0}.card,.panel{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:17px}.metric{font-size:27px;font-weight:850;margin-top:8px}.metric-label{color:var(--muted);font-size:12px}.layout{display:grid;grid-template-columns:1fr 1fr;gap:14px}.panel h3{margin:0 0 14px;font-size:15px}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:14px 0}.toolbar input{flex:1;min-width:180px}.field,input,select,textarea{background:#101013;color:#eee;border:1px solid #36363d;border-radius:8px;padding:10px;width:100%;outline:none}.field:focus,input:focus,select:focus,textarea:focus{border-color:var(--yellow)}.tablewrap{overflow:auto;border:1px solid var(--line);border-radius:12px}table{width:100%;border-collapse:collapse;min-width:760px}th,td{text-align:left;padding:12px 13px;border-bottom:1px solid var(--line);vertical-align:top}th{font-size:11px;text-transform:uppercase;letter-spacing:.7px;color:#aaa;background:#19191d}tr:last-child td{border-bottom:0}.pill{display:inline-block;border-radius:99px;padding:4px 8px;font-size:11px;font-weight:800;background:#29292f;color:#ddd}.pill.good{background:#12351f;color:#86efac}.pill.warn{background:#3b2e09;color:#fde047}.pill.bad{background:#451a1a;color:#fca5a5}.actions{display:flex;gap:6px;flex-wrap:wrap}.actions button{padding:6px 9px;font-size:12px}.empty{padding:35px;text-align:center;color:var(--muted)}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.formgrid label{display:grid;gap:6px;color:#bbb;font-size:12px}.formgrid .wide{grid-column:1/-1}.modal{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;padding:18px;z-index:5}.modal.open{display:flex}.dialog{width:min(720px,100%);max-height:90vh;overflow:auto;background:#17171b;border:1px solid #3a3a40;border-radius:16px;padding:22px}.dialoghead{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.dialoghead h2{margin:0}.formactions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}.notice{background:#292710;border:1px solid #5c5012;color:#fef08a;padding:12px 14px;border-radius:10px;margin-bottom:16px}.hidden{display:none!important}.mobilemenu{display:none}.subtext{font-size:12px;color:var(--muted)}@media(max-width:1000px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.layout{grid-template-columns:1fr}}@media(max-width:700px){.app{display:block}.side{width:auto;padding:12px;border-right:0;border-bottom:1px solid var(--line)}.brand{margin:4px 6px 10px}.nav{display:flex;overflow:auto}.nav button{white-space:nowrap;padding:9px}.main{width:100%;padding:17px}.title{font-size:23px}.cards{gap:8px}.card{padding:12px}.metric{font-size:22px}.formgrid{grid-template-columns:1fr}.formgrid .wide{grid-column:auto}.top{align-items:flex-start}.top button{white-space:nowrap}}
</style>
</head>
<body>
<div class="app">
<aside class="side"><div class="brand">BLACK<span>PANEL</span></div><div class="nav" id="nav"></div><div style="margin:22px 8px 0" class="subtext">CRM PESSOAL · VERSÃO LOCAL</div></aside>
<main class="main">
<header class="top"><div><div class="eyebrow">Seu negócio, sob controle</div><div class="title" id="pageTitle">Dashboard</div><div class="muted" id="pageSub">Resumo do seu negócio</div></div><button onclick="openForm()">＋ Novo registro</button></header>
<div class="notice">Versão local: seus registros ficam salvos neste navegador neste computador. Use <b>Exportar backup</b> regularmente. Ainda não há sincronização em nuvem nem login.</div>
<section id="content"></section>
<footer style="margin-top:24px;display:flex;gap:8px;flex-wrap:wrap"><button class="secondary" onclick="exportBackup()">Exportar backup JSON</button><button class="secondary" onclick="document.getElementById('importFile').click()">Importar backup JSON</button><button class="secondary" onclick="exportCSV()">Exportar tabela CSV</button><input id="importFile" type="file" accept=".json,application/json" class="hidden" onchange="importBackup(event)"></footer>
</main></div>
<div class="modal" id="modal"><div class="dialog"><div class="dialoghead"><h2 id="formTitle">Novo registro</h2><button class="secondary" onclick="closeForm()">Fechar</button></div><form id="recordForm"><div id="formFields" class="formgrid"></div><div class="formactions"><button type="button" class="secondary" onclick="closeForm()">Cancelar</button><button type="submit">Salvar registro</button></div></form></div></div>
<script>
const sections={
dashboard:{label:'Dashboard',icon:'▦'},
clientes:{label:'Clientes',icon:'♙',fields:[['nome','Nome do cliente','text',1],['empresa','Empresa','text',1],['whatsapp','WhatsApp','tel'],['email','E-mail','email'],['nicho','Nicho','text'],['cidade','Cidade','text'],['data','Data de entrada','date'],['status','Status','select',['Prospecto','Negociação','Cliente ativo','Inativo']],['observacoes','Observações','textarea',1]]},
sites:{label:'Sites',icon:'▣',fields:[['nome','Nome do projeto','text',1],['cliente','Cliente / empresa','text',1],['url','Link público','url'],['dominio','Domínio','text'],['hospedagem','Hospedagem','text'],['plataforma','Local do projeto / plataforma','text'],['repositorio','Link GitHub','url'],['criacao','Data de criação','date'],['publicacao','Data de publicação','date'],['renovacao','Renovação domínio','date'],['renovahost','Renovação hospedagem','date'],['valor','Valor da criação (R$)','number'],['mensalidade','Manutenção mensal (R$)','number'],['status','Status','select',['Em desenvolvimento','Publicado','Pausado','Cancelado']],['observacoes','Observações técnicas','textarea',1]]},
vendas:{label:'Vendas',icon:'↗',fields:[['cliente','Cliente','text',1],['projeto','Projeto vendido','text',1],['servico','Tipo de serviço','select',['Criação de site','Manutenção','Landing page','Cardápio digital','Outro']],['valor','Valor total (R$)','number',1],['data','Data da venda','date'],['forma','Forma de pagamento','text'],['recebido','Valor recebido (R$)','number'],['status','Situação','select',['Pendente','Parcialmente pago','Pago']],['observacoes','Observações','textarea',1]]},
pagamentos:{label:'Pagamentos',icon:'＄',fields:[['cliente','Cliente','text',1],['site','Site relacionado','text'],['valor','Valor da cobrança (R$)','number',1],['vencimento','Data de vencimento','date',1],['pagoem','Data do pagamento','date'],['status','Status','select',['Em dia','Pago','Pendente']],['observacoes','Observações','textarea',1]]},
dominios:{label:'Domínios e hospedagem',icon:'◎',fields:[['dominio','Domínio','text',1],['site','Site relacionado','text'],['cliente','Cliente','text'],['registrador','Registrador','text'],['provedor','Provedor de hospedagem','text'],['vencimento','Data de renovação','date',1],['custo','Custo da renovação (R$)','number'],['status','Status','select',['Ativo','A renovar','Renovado','Cancelado']],['painel','Link do painel administrativo','url']]},
prospeccao:{label:'Prospecção',icon:'⌁',fields:[['empresa','Empresa','text',1],['contato','Nome do contato','text'],['whatsapp','WhatsApp','tel'],['nicho','Nicho','text'],['valor','Valor potencial (R$)','number'],['etapa','Etapa','select',['Empresa encontrada','Primeiro contato realizado','Aguardando resposta','Negociação','Demonstração enviada','Fechado','Perdido'],1],['ultimo','Data do último contato','date'],['proxima','Próxima ação','text'],['dataacao','Data da próxima ação','date'],['observacoes','Observações','textarea',1]]}
};
let db=loadDB(),current='dashboard',editing=null;
function loadDB(){try{return JSON.parse(localStorage.getItem('blackpanel_db'))||{clientes:[],sites:[],vendas:[],pagamentos:[],dominios:[],prospeccao:[]}}catch(e){return {clientes:[],sites:[],vendas:[],pagamentos:[],dominios:[],prospeccao:[]}}}
function save(){localStorage.setItem('blackpanel_db',JSON.stringify(db))}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function money(n){return Number(n||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'})}
function dateBR(d){if(!d)return '—';let x=new Date(d+'T00:00:00');return isNaN(x)?esc(d):x.toLocaleDateString('pt-BR')}
function today(){return new Date().toISOString().slice(0,10)}
function nav(){document.getElementById('nav').innerHTML=Object.entries(sections).map(([k,v])=>`<button class="${current===k?'active':''}" onclick="go('${k}')">${v.icon} &nbsp;${v.label}</button>`).join('')}
function go(k){current=k;nav();render()}
function pill(s){let c=/Pago|Publicado|Cliente ativo|Ativo|Fechado|Em dia|Renovado/i.test(s)?'good':/Aguardando|Negociação|Demonstração|vence|A renovar|Parcial/i.test(s)?'warn':/Atrasado|Perdido|Cancelado|Inativo|Pendente/i.test(s)?'bad':'';return `<span class="pill ${c}">${esc(s||'—')}</span>`}
function render(){let title=sections[current].label;document.getElementById('pageTitle').textContent=title;document.getElementById('pageSub').textContent=current==='dashboard'?'Resumo do seu negócio':'Gerencie e atualize seus registros';let c=document.getElementById('content');if(current==='dashboard'){let clients=db.clientes.length,sites=db.sites.filter(x=>x.status==='Publicado').length,dev=db.sites.filter(x=>x.status==='Em desenvolvimento').length,sales=db.vendas.reduce((a,x)=>a+Number(x.valor||0),0),received=db.vendas.reduce((a,x)=>a+Number(x.recebido||0),0),recurring=db.sites.reduce((a,x)=>a+Number(x.mensalidade||0),0),pending=db.pagamentos.filter(x=>x.status!=='Pago').length,late=db.pagamentos.filter(x=>x.status!=='Pago'&&x.vencimento&&x.vencimento<today()).length,renew=db.dominios.filter(x=>x.vencimento&&x.vencimento>=today()&&x.vencimento<new Date(Date.now()+30*864e5).toISOString().slice(0,10)).length;
c.innerHTML=`<div class="cards">${[['Clientes',clients],['Sites publicados',sites],['Em desenvolvimento',dev],['Total vendido',money(sales)],['Total recebido',money(received)],['Receita recorrente estimada',money(recurring)],['Cobranças em aberto',pending],['Pagamentos atrasados',late],['Renovações em 30 dias',renew]].map(x=>`<div class="card"><div class="metric-label">${x[0]}</div><div class="metric">${x[1]}</div></div>`).join('')}</div><div class="layout"><div class="panel"><h3>Atividade do negócio</h3><p class="muted">Vendas registradas: <b>${db.vendas.length}</b></p><p class="muted">Clientes ativos: <b>${db.clientes.filter(x=>x.status==='Cliente ativo').length}</b></p><p class="muted">Domínios cadastrados: <b>${db.dominios.length}</b></p><p class="muted">Oportunidades no funil: <b>${db.prospeccao.length}</b></p></div><div class="panel"><h3>Próximas ações</h3>${[...db.pagamentos.filter(x=>x.status!=='Pago'&&x.vencimento).map(x=>({nome:'Cobrança: '+x.cliente,data:x.vencimento})),...db.dominios.filter(x=>x.vencimento).map(x=>({nome:'Renovação: '+x.dominio,data:x.vencimento})),...db.prospeccao.filter(x=>x.dataacao).map(x=>({nome:'Follow-up: '+x.empresa,data:x.dataacao}))].sort((a,b)=>a.data.localeCompare(b.data)).slice(0,6).map(x=>`<p>${pill(dateBR(x.data))} &nbsp; ${esc(x.nome)}</p>`).join('')||'<p class="muted">Nenhuma ação cadastrada ainda.</p>'}</div></div>`;return}
let s=sections[current],rows=db[current]||[];c.innerHTML=`<div class="toolbar"><input id="search" placeholder="Buscar em ${s.label.toLowerCase()}..." oninput="renderTable()"><button onclick="openForm()">＋ Adicionar</button></div><div id="table"></div>`;renderTable()}
function renderTable(){let s=sections[current],rows=db[current]||[],q=(document.getElementById('search')?.value||'').toLowerCase();rows=rows.filter(r=>Object.values(r).some(v=>String(v??'').toLowerCase().includes(q)));let fields=s.fields.map(f=>f[0]),show=fields.slice(0,6);if(!rows.length){document.getElementById('table').innerHTML='<div class="panel empty">Nenhum registro encontrado. Clique em “Adicionar” para começar.</div>';return}
let head=show.map(k=>`<th>${esc(s.fields.find(f=>f[0]===k)?.[1]||k)}</th>`).join('');let body=rows.map(r=>`<tr>${show.map(k=>{let f=s.fields.find(x=>x[0]===k),v=r[k];if(k==='valor'||k==='recebido'||k==='mensalidade'||k==='custo')v=money(v);if(f?.[2]==='date')v=dateBR(v);if(k==='url'||k==='repositorio'||k==='painel'){v=v?`<a style="color:var(--yellow)" href="${esc(v)}" target="_blank" rel="noopener">Abrir link ↗</a>`:'—'}if(k==='status'||k==='etapa')v=pill(v);return `<td>${v&&String(v).includes('<span')||v&&String(v).includes('<a ')?v:esc(v||'—')}</td>`}).join('')}<td><div class="actions"><button class="secondary" onclick="editRecord('${r.id}')">Editar</button><button class="danger" onclick="deleteRecord('${r.id}')">Excluir</button>${r.whatsapp?`<button class="secondary" onclick="whats('${esc(r.whatsapp)}','Olá ${esc(r.nome||r.empresa||r.cliente||'')}, tudo bem?')">WhatsApp</button>`:''}${current==='pagamentos'&&r.status!=='Pago'?`<button onclick="charge('${r.id}')">Cobrar</button>`:''}</div></td></tr>`).join('');document.getElementById('table').innerHTML=`<div class="tablewrap"><table><thead><tr>${head}<th>Ações</th></tr></thead><tbody>${body}</tbody></table></div><p class="subtext">${rows.length} registro(s)</p>`}
function openForm(id=null){editing=id;let s=sections[current];if(current==='dashboard')return go('clientes');let rec=id?db[current].find(x=>x.id===id):{};document.getElementById('formTitle').textContent=id?'Editar registro':'Novo registro — '+s.label;document.getElementById('formFields').innerHTML=s.fields.map(f=>{let [k,label,type,extra]=f,v=rec?.[k]??(type==='date'&&k==='data'?today():'');let required=extra===1?'required':'';let inp=type==='select'?`<select name="${k}" ${required}>${extra.map(o=>`<option ${v===o?'selected':''}>${esc(o)}</option>`).join('')}</select>`:type==='textarea'?`<textarea name="${k}" rows="3">${esc(v)}</textarea>`:`<input name="${k}" type="${type}" value="${esc(v)}" ${required} ${type==='number'?'min="0" step="0.01"':''}>`;return `<label class="${type==='textarea'?'wide':''}">${esc(label)}${inp}</label>`}).join('');document.getElementById('modal').classList.add('open')}
function closeForm(){document.getElementById('modal').classList.remove('open')}
document.getElementById('recordForm').addEventListener('submit',e=>{e.preventDefault();let data=Object.fromEntries(new FormData(e.target).entries());if(['valor','recebido','mensalidade','custo'].some(k=>data[k]!==undefined))Object.keys(data).forEach(k=>{if(['valor','recebido','mensalidade','custo'].includes(k))data[k]=Number(data[k]||0)});if(current==='vendas'&&data.valor!==undefined)data.restante=Math.max(0,Number(data.valor)-Number(data.recebido||0));if(current==='pagamentos'&&data.status!=='Pago'&&data.vencimento&&data.vencimento<today())data.status='Pendente';if(editing){let i=db[current].findIndex(x=>x.id===editing);db[current][i]={...db[current][i],...data}}else db[current].unshift({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),...data,createdAt:new Date().toISOString()});save();closeForm();render()});
function editRecord(id){openForm(id)}
function deleteRecord(id){if(confirm('Excluir este registro? Esta ação não pode ser desfeita.')){db[current]=db[current].filter(x=>x.id!==id);save();render()}}
function whats(phone,msg){let n=String(phone).replace(/\D/g,'');if(n.length===10||n.length===11)n='55'+n;if(!n){alert('Cadastre um WhatsApp válido.');return}open('https://wa.me/'+n+'?text='+encodeURIComponent(msg),'_blank','noopener')}
function charge(id){let r=db.pagamentos.find(x=>x.id===id);whats((db.clientes.find(c=>c.nome===r.cliente||c.empresa===r.cliente)||{}).whatsapp||'',`Olá, tudo bem? Passando para lembrar que a cobrança referente a ${r.site||'seu site'} vence em ${dateBR(r.vencimento)}, no valor de ${money(r.valor)}. Qualquer dúvida, estou à disposição!`)}
function exportBackup(){let a=document.createElement('a'),b=new Blob([JSON.stringify(db,null,2)],{type:'application/json'});a.href=URL.createObjectURL(b);a.download='blackpanel-backup.json';a.click();URL.revokeObjectURL(a.href)}
function importBackup(e){let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let d=JSON.parse(r.result);if(!confirm('Importar backup e substituir os registros atuais?'))return;db={...db,...d};save();render();alert('Backup importado.')}catch(err){alert('Arquivo de backup inválido.')}};r.readAsText(f);e.target.value=''}
function exportCSV(){let rows=db[current]||[];if(!rows.length){alert('Não há registros nesta seção para exportar.');return}let keys=[...new Set(rows.flatMap(Object.keys))],csv=[keys.join(';'),...rows.map(r=>keys.map(k=>'"'+String(r[k]??'').replace(/"/g,'""')+'"').join(';'))].join('\r\n');let a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download='blackpanel-'+current+'.csv';a.click();URL.revokeObjectURL(a.href)}
nav();render();
</script>
</body></html>
